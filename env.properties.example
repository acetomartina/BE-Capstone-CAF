# Copiare questo file in env.properties e compilarlo.
# env.properties e' escluso dal versionamento: non contiene mai segreti reali.

# ===============================
# DATABASE (obbligatorio)
# ===============================
DB_URL=jdbc:postgresql://localhost:5432/caf_fapi
DB_USER=
DB_PASSWORD=

# ===============================
# AUTENTICAZIONE (obbligatorio)
# ===============================
# JWT_SECRET deve essere una stringa Base64 di almeno 32 byte.
# Per generarla: openssl rand -base64 32
JWT_SECRET=
JWT_EXPIRATION=86400000

# ===============================
# PRIMO AMMINISTRATORE (obbligatorio)
# ===============================
# Creato automaticamente al primo avvio se la tabella utenti non
# contiene gia' un SUPER_ADMIN. Senza queste variabili l'applicazione
# non parte: non hanno un valore predefinito.
SUPER_ADMIN_NOME=
SUPER_ADMIN_COGNOME=
SUPER_ADMIN_CODICE_FISCALE=
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=

# ===============================
# POSTA (facoltativo)
# ===============================
# Senza credenziali l'applicazione parte lo stesso: l'invio fallisce
# e viene registrato nei log, il resto del flusso resta usabile.
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_MITTENTE=no-reply@caf-fapi-pianopoli.it

# ===============================
# COLLEGAMENTO AL FRONTEND
# ===============================
# Base dei link inviati per mail (reset password), senza slash finale.
FRONTEND_URL=http://localhost:5173

# Origini ammesse dal browser, separate da virgola.
# In produzione: il dominio reale del frontend.
CORS_ALLOWED_ORIGINS=http://localhost:5173

RESET_PASSWORD_DURATA_MINUTI=30
